CTC_DOMAIN=moderation.example.com
CTC_SHADOW=1            # start in shadow mode; set 0 to enforce decisions
CTC_KILL_SWITCH=0       # 1 = skip models, send everything to REVIEW
CTC_CONCURRENCY=2       # parallel inferences (= vCPUs)
CTC_ORT_THREADS=1       # threads per inference (vCPUs / CTC_CONCURRENCY)
CTC_QUEUE=16            # waiting requests beyond this get 503 OVERLOADED
CTC_TIMEOUT_S=10
CTC_ALLOW_URL=0         # image_url input (SSRF-guarded); keep off unless needed
