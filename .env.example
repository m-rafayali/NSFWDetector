# Comments must be on their own line: Podman's env-file parser keeps inline "# ..." as part of the value.
CTC_DOMAIN=moderation.example.com
# 1 = shadow mode (log real decision, always return APPROVE). Start with 1; set 0 to enforce.
CTC_SHADOW=1
# 1 = skip models, send everything to REVIEW
CTC_KILL_SWITCH=0
# parallel inferences (= vCPUs) and threads per inference (vCPUs / CTC_CONCURRENCY)
CTC_CONCURRENCY=2
CTC_ORT_THREADS=1
# waiting requests beyond this get 503 OVERLOADED
CTC_QUEUE=16
CTC_TIMEOUT_S=10
# image_url input (SSRF-guarded); keep off unless needed
CTC_ALLOW_URL=0
